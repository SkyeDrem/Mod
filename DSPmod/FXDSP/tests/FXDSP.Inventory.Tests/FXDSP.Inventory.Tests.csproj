<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)../../NuGet.Config</RestoreConfigFile>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FXDSP/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../src/FXDSP/Runtime/PlayerInventory.cs" Link="Runtime/PlayerInventory.cs" />
  </ItemGroup>
</Project>
